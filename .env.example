# Copiar a .env y completar valores

# Servidor
PORT=3001

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=eduscout
DATABASE_USER=postgres
DATABASE_PASSWORD=cambiar-por-una-password-fuerte
DATABASE_URL=postgresql://postgres:cambiar-por-una-password-fuerte@localhost:5432/eduscout?client_encoding=utf8

# Autenticación admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-una-password-fuerte
ADMIN_TOKEN_SECRET=generar-con-openssl-rand-hex-32
ADMIN_TOKEN_TTL_MS=7200000

# Autenticación de postulantes
CANDIDATE_TOKEN_SECRET=generar-con-openssl-rand-hex-32
CANDIDATE_TOKEN_TTL_MS=604800000

# Correo SMTP (recuperación de contraseña; sin configurar, los correos se loguean en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduScout <no-reply@eduscout.cl>
FRONTEND_URL=http://localhost:3000

# Notificaciones de alertas (1 dígesto por postulante por corrida de scraping)
ALERTS_NOTIFY_ENABLED=true
ALERTS_NOTIFY_MAX_PER_RUN=500
ALERTS_NOTIFY_DELAY_MS=0

# Scraping
SCRAPING_CRON_ENABLED=true

# Telegram (opcional, requerido para informes y bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
